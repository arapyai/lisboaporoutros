# Copie para .env.preview.local. Nunca versione o token real.
TUNNEL_TOKEN=

# Hostnames configurados no Cloudflare Zero Trust para o tunnel nomeado.
PREVIEW_WEBAPP_URL=https://preview.lisbon.literarymap.org
PREVIEW_ADMIN_URL=https://admin-preview.lisbon.literarymap.org
PREVIEW_API_URL=https://api-preview.lisbon.literarymap.org

# O script aceita somente localhost/127.0.0.1 e banco terminado em _preview.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/lisboa_por_outros_preview

# Projeto e serviço de desenvolvimento da Railway.
RAILWAY_PROJECT_ID=8c685205-c8a0-4489-b09b-7212fb8ec0fd
RAILWAY_ENVIRONMENT=development
RAILWAY_DATABASE_SERVICE=postgres-dev

# Última migration comum entre o snapshot de development e esta branch.
LOCAL_ALEMBIC_BASE_REVISION=20260805_000018
